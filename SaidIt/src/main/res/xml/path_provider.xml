<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The shared Echo directory, used when it is writable. -->
    <external-path
        name="external_files"
        path="." />
    <!-- Android/data/<pkg>/files, the first fallback. -->
    <external-files-path
        name="external_app_files"
        path="." />
    <!-- Internal storage, the last resort. -->
    <files-path
        name="internal_files"
        path="." />
</paths>
