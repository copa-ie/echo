<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recordings_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        The header (title, summary, ranges) is added to the ListView itself via
        addHeaderView, not placed here: with hundreds of recordings the ranges block can
        grow taller than the screen, and as a sibling above the list it would take all the
        space away from it, leaving nothing to scroll in. Inside the list it scrolls with
        everything else instead of competing for room.
    -->
    <ListView
        android:id="@+id/recordings_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/gray_6"
        android:dividerHeight="1dp"
        android:scrollbarStyle="outsideOverlay" />

    <Button
        android:id="@+id/recordings_return"
        style="@style/Button"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_return" />

</LinearLayout>
