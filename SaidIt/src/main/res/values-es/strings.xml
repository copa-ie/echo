    <!-- Modo de bajo consumo -->

    <string name="low_power_title">Modo de bajo consumo</string>
    <string name="low_power_on">Bajo consumo: ACTIVADO</string>
    <string name="low_power_off">Bajo consumo: desactivado</string>
    <string name="low_power_hint">Graba a 8 kHz: peor calidad, un sexto de los datos y muchos menos despertares del CPU.</string>
    <string name="low_power_description">Para cuando la batería importa más que la fidelidad. La captura baja a 8 kHz, suficiente para entender el habla, así que el búfer del micrófono dura seis veces más entre despertares, los archivos ocupan un sexto y esta pantalla se refresca menos a menudo. Al desactivarlo se recupera la calidad anterior. Lo que haya en memoria se guarda antes del cambio, porque la memoria de audio no puede sobrevivir a un cambio de formato.</string>
    <string name="notification_low_power_suffix">· bajo consumo</string>

    <!-- Registro GPS -->

    <string name="gps_title">Registro GPS</string>
    <string name="gps_on">Registro GPS: ACTIVO</string>
    <string name="gps_off">Registro GPS: apagado</string>
    <string name="gps_hint">Registra dónde estuviste, guardado como una traza .gpx junto a cada grabación.</string>
    <string name="gps_description">Mientras Echo escucha, se toma una posición cada pocos segundos y se escribe con los mismos guardados que el audio, en un archivo con el mismo nombre y extensión .gpx. Cualquier app de mapas o GPS lo abre. Las posiciones se detienen con la grabación, y los huecos de señal se conservan como huecos en lugar de dibujarse como líneas rectas. En modo de bajo consumo se toma una posición cada 30 segundos en vez de cada 5.</string>
    <string name="gps_permission_needed">Echo necesita permiso de ubicación para registrar una traza GPS.</string>
    <string name="gps_provider_off">El GPS está apagado en este dispositivo, así que no llegará ninguna posición. Activa la ubicación en los ajustes del sistema.</string>
    <string name="notification_gps_suffix">\u00b7 GPS</string>

